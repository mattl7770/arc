{
  "expo": {
    "name": "ARC",
    "slug": "arc",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "arc",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "web"],
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arcresilience.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E7E4DA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "ARC uses the camera to scan food barcodes and photograph meals for logging.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ARC uses Face ID to lock the app so only you can open your health data."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ARC opens your photo library so you can log a meal from a photo you already took, or import a recipe or a workout from a screenshot.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 1
            }
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "ARC reads sleep, heart, activity and workout data from Apple Health to power readiness and recovery.",
          "NSHealthUpdateUsageDescription": "ARC writes the weight, body-fat percentage and waist measurements you record in ARC to Apple Health, so other apps on your iPhone can see them. Nothing else is written.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "57331eea-ba13-41cc-898f-43194a21aae3"
      }
    },
    "owner": "architecture-for-resilience-and-continuity",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/57331eea-ba13-41cc-898f-43194a21aae3"
    }
  }
}
