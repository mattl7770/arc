# ---------------------------------------------------------------------------
# ARC environment
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# IMPORTANT: anything prefixed with EXPO_PUBLIC_ is inlined into the JS bundle
# at build time and is therefore readable by anyone who has the app. Only put
# values there that are safe to ship publicly. Server-only secrets belong in
# Supabase Edge Function secrets and must never take an EXPO_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# --- Supabase (client) -----------------------------------------------------
# Both are safe to expose: the anon key is gated by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- App -------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development

# ---------------------------------------------------------------------------
# Server-side only. These are NOT read by the Expo app. They are listed here as
# a reference for the Supabase Edge Functions and scripts that will consume
# them (`supabase secrets set ...`).
# ---------------------------------------------------------------------------

# --- AI providers ----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# --- Supabase (server) -----------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# --- Wearables (later) -----------------------------------------------------
TERRA_API_KEY=
TERRA_DEV_ID=
