# Normalise line endings so the repo stays diff-clean across macOS, Windows,
# CI, and the various AI coding tools that touch this project.
* text=auto eol=lf

# Binary assets — never normalise or diff these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated — collapse in review.
package-lock.json linguist-generated=true
src/types/database.ts linguist-generated=true
